###############################
# e-wallet Environment Example
###############################

# Postgres settings
db_name=ewallet
db_username=ewallet
db_password=ewallet

# JWT secret (will be auto-generated in .env if left blank)
jwt_secret=

# (Optional) Override API base URL for frontend (normally auto-set)
REACT_APP_API_BASE_URL=http://localhost:8080/api/v1
